#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/bootstrap.php';

use MahakMixin\AppFactory;
use MahakMixin\Client\MahakClient;
use MahakMixin\Client\MixinClient;
use MahakMixin\Config;
use MahakMixin\Http\HttpException;
use MahakMixin\Support\TestProductFactory;
use MahakMixin\Version;
$command = $argv[1] ?? 'help';

try {
    $result = match ($command) {
        '--version', '-V', 'version' => ['service' => 'mahak-mixin-bridge', 'version' => Version::current()],
        'mahak:login' => sanitizeLogin(AppFactory::mahak()->login()),
        'mahak:products:inspect' => inspectMahakProducts(AppFactory::mahak(), Config::int('MAHAK_VISITOR_ID')),
        'mahak:products:diagnose' => diagnoseMahakProductFields(AppFactory::mahak(), Config::int('MAHAK_VISITOR_ID')),
        'mahak:products:candidates' => listMahakProductCandidates(AppFactory::mahak(), Config::int('MAHAK_VISITOR_ID')),
        'mahak:images:diagnose' => diagnoseMahakImages(AppFactory::mahak(), Config::int('MAHAK_VISITOR_ID')),
        'mixin:health' => AppFactory::mixin()->health(),
        'mixin:info' => AppFactory::mixin()->info(),
        'mixin:categories:inspect' => AppFactory::mixin()->categories(['page' => 1, 'page_size' => 50]),
        'mixin:products:delete-all' => purgeAllMixinProducts($argv),
        'mixin:fallback-category:ensure' => ensureFallbackCategory(AppFactory::mixin()),
        'mixin:test-product:preview' => TestProductFactory::make('preview', optionalPositiveInt('MIXIN_TEST_CATEGORY_ID')),
        'mixin:test-product:create' => createMixinTestProduct(AppFactory::mixin()),
        'mixin:test-product:delete' => deleteMixinTestProduct(AppFactory::mixin(), $argv[2] ?? null),
        'sync:product:preview' => syncOneProduct($argv, true),
        'sync:product:apply' => syncOneProduct($argv, false),
        'sync:product:rollback' => rollbackOneProduct($argv),
        'sync:product:image:preview' => previewOneProductImage($argv),
        'sync:product:image:apply' => applyOneProductImage($argv),
        'sync:product:image:rollback' => rollbackOneProductImage($argv),
        'sync:products' => AppFactory::productSync()->run(Config::bool('SYNC_DRY_RUN', true)),
        'sync:products:dry-run' => AppFactory::productSync()->run(true),
        'sync:catalog:full:dry-run' => AppFactory::fullCatalogSync()->run(true),
        'sync:catalog:full' => runFullCatalog(),
        'sync:products:baseline' => AppFactory::fullCatalogSync()->baseline(),
        default => [
            'usage' => [
                'php bin/console --version',
                'php bin/console mahak:login',
                'php bin/console mahak:products:inspect',
                'php bin/console mahak:products:diagnose',
                'php bin/console mahak:products:candidates',
                'php bin/console mahak:images:diagnose',
                'php bin/console mixin:health',
                'php bin/console mixin:info',
                'php bin/console mixin:categories:inspect',
                'php bin/console mixin:products:delete-all DELETE-ALL-PRODUCTS',
                'php bin/console mixin:fallback-category:ensure',
                'php bin/console mixin:test-product:preview',
                'php bin/console mixin:test-product:create',
                'php bin/console mixin:test-product:delete PRODUCT_ID',
                'php bin/console sync:product:preview PRODUCT_DETAIL_ID MIXIN_CATEGORY_ID',
                'php bin/console sync:product:apply PRODUCT_DETAIL_ID MIXIN_CATEGORY_ID',
                'php bin/console sync:product:rollback PRODUCT_DETAIL_ID',
                'php bin/console sync:product:image:preview PRODUCT_DETAIL_ID',
                'php bin/console sync:product:image:apply PRODUCT_DETAIL_ID',
                'php bin/console sync:product:image:rollback PRODUCT_DETAIL_ID IMAGE_ID',
                'php bin/console sync:products:dry-run',
                'php bin/console sync:products',
                'php bin/console sync:catalog:full:dry-run',
                'php bin/console sync:catalog:full',
                'php bin/console sync:products:baseline',
            ],
        ],
    };
    echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL;
    exit(0);
} catch (Throwable $exception) {
    $error = [
        'ok' => false,
        'error' => $exception->getMessage(),
        'type' => $exception::class,
    ];
    if ($exception instanceof HttpException) {
        $error['status_code'] = $exception->statusCode;
        $error['response'] = sanitizeDiagnostic($exception->responseBody);
    }
    fwrite(STDERR, json_encode($error, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL);
    exit(1);
}

function sanitizeDiagnostic(mixed $value, ?string $key = null): mixed
{
    if ($key !== null && preg_match('/authorization|api.?key|token|password|secret/i', $key) === 1) {
        return '[REDACTED]';
    }
    if (is_array($value)) {
        $safe = [];
        foreach ($value as $childKey => $childValue) {
            $safe[$childKey] = sanitizeDiagnostic($childValue, (string) $childKey);
        }
        return $safe;
    }
    if (is_string($value) && strlen($value) > 2000) {
        return substr($value, 0, 2000) . '...[truncated]';
    }
    return $value;
}

function sanitizeLogin(array $response): array
{
    foreach ($response as $key => &$value) {
        if (strcasecmp((string) $key, 'UserToken') === 0) {
            $value = '[REDACTED]';
        } elseif (is_array($value)) {
            $value = sanitizeLogin($value);
        }
    }
    return $response;
}

function inspectMahakProducts(MahakClient $client, int $visitorId): array
{
    $login = $client->login();
    $response = $client->getAllData([
        'currentVisitorId' => $visitorId,
        'fromProductVersion' => 0,
        'fromProductDetailVersion' => 0,
        'fromVisitorProductVersion' => 0,
        'fromProductCategoryVersion' => 0,
        'pageSize' => 5,
    ]);

    $loginData = ciValue($login, 'Data', []);
    $data = ciValue($response, 'Data', []);
    $objects = is_array($data) ? ciValue($data, 'Objects', []) : [];
    $counts = [];
    if (is_array($objects)) {
        foreach ($objects as $name => $items) {
            if (is_array($items)) {
                $counts[(string) $name] = count($items);
            }
        }
    }

    return [
        'login' => [
            'visitor_id' => is_array($loginData) ? ciValue($loginData, 'VisitorId') : null,
            'database_id' => is_array($loginData) ? ciValue($loginData, 'DatabaseId') : null,
            'with_data_transfer' => is_array($loginData) ? ciValue($loginData, 'WithDataTransfer') : null,
        ],
        'response' => [
            'result' => ciValue($response, 'Result'),
            'code' => ciValue($response, 'Code'),
            'message' => ciValue($response, 'Message'),
            'object_keys' => is_array($objects) ? array_keys($objects) : [],
            'counts' => $counts,
        ],
    ];
}

function diagnoseMahakProductFields(MahakClient $client, int $visitorId): array
{
    $login = $client->login();
    $loginData = ciValue($login, 'Data', []);
    if ($visitorId <= 0 && is_array($loginData)) {
        $visitorId = (int) ciValue($loginData, 'VisitorId', 0);
    }

    $response = $client->getAllData([
        'currentVisitorId' => $visitorId,
        'fromProductVersion' => 0,
        'fromProductDetailVersion' => 0,
        'fromVisitorProductVersion' => 0,
        'pageSize' => 5,
    ]);
    $data = ciValue($response, 'Data', []);
    $objects = is_array($data) ? ciValue($data, 'Objects', []) : [];
    if (!is_array($objects)) {
        $objects = [];
    }

    return [
        'visitor_id' => $visitorId,
        'products' => diagnosticRows(ciValue($objects, 'Products', []), 'ProductId'),
        'product_details' => diagnosticRows(ciValue($objects, 'ProductDetails', []), 'ProductDetailId'),
        'visitor_products' => diagnosticRows(ciValue($objects, 'VisitorProducts', []), 'ProductDetailId'),
    ];
}

function listMahakProductCandidates(MahakClient $client, int $visitorId): array
{
    $response = $client->getAllData([
        'currentVisitorId' => $visitorId,
        'fromProductVersion' => 0,
        'fromProductDetailVersion' => 0,
        'fromVisitorProductVersion' => 0,
        'fromProductCategoryVersion' => 0,
        'pageSize' => Config::int('SYNC_PAGE_SIZE', 100),
    ]);
    $data = ciValue($response, 'Data', []);
    $objects = is_array($data) ? ciValue($data, 'Objects', []) : [];
    if (!is_array($objects)) {
        return ['count' => 0, 'items' => []];
    }

    $products = indexDiagnosticRows(ciValue($objects, 'Products', []), 'ProductId');
    $visitorProducts = indexDiagnosticRows(ciValue($objects, 'VisitorProducts', []), 'ProductDetailId');
    $categories = indexDiagnosticRows(ciValue($objects, 'ProductCategories', []), 'ProductCategoryId');
    $items = [];
    foreach ((array) ciValue($objects, 'ProductDetails', []) as $detail) {
        if (!is_array($detail)) {
            continue;
        }
        $detailId = (string) ciValue($detail, 'ProductDetailId', '');
        $productId = (string) ciValue($detail, 'ProductId', '');
        $product = $products[$productId] ?? [];
        $visitor = $visitorProducts[$detailId] ?? [];
        $categoryId = (string) ciValue($product, 'ProductCategoryId', '');
        $detailPrice2 = (float) ciValue($detail, 'Price2', 0);
        $detailPrice1 = (float) ciValue($detail, 'Price1', 0);
        $rawPrice = $detailPrice2 > 0 ? $detailPrice2 : $detailPrice1;
        $items[] = [
            'product_detail_id' => $detailId,
            'product_id' => $productId,
            'product_code' => ciValue($product, 'ProductCode'),
            'product_detail_code' => ciValue($detail, 'ProductDetailCode'),
            'name' => ciValue($product, 'Name'),
            'mahak_category_id' => $categoryId,
            'mahak_category_name' => ciValue($categories[$categoryId] ?? [], 'Name'),
            'unit_name' => ciValue($product, 'UnitName'),
            'unit_name_2' => ciValue($product, 'UnitName2'),
            'unit_ratio' => ciValue($product, 'UnitRatio'),
            'properties' => ciValue($detail, 'Properties'),
            'barcode' => ciValue($detail, 'Barcode'),
            'price_source' => $detailPrice2 > 0 ? 'ProductDetail.Price2' : 'ProductDetail.Price1',
            'price1_raw' => $detailPrice1,
            'price2_raw' => $detailPrice2,
            'price_raw' => $rawPrice,
            'price_mixin' => (int) round($rawPrice / Config::int('SYNC_PRICE_DIVISOR', 10)),
            'stock_source' => 'VisitorProduct.Count1',
            'stock' => ciValue($visitor, 'Count1'),
            'count_2' => ciValue($visitor, 'Count2'),
        ];
    }
    return ['count' => count($items), 'items' => $items];
}

function indexDiagnosticRows(mixed $items, string $idKey): array
{
    $indexed = [];
    if (!is_array($items)) {
        return $indexed;
    }
    foreach ($items as $item) {
        if (is_array($item)) {
            $id = ciValue($item, $idKey);
            if ($id !== null) {
                $indexed[(string) $id] = $item;
            }
        }
    }
    return $indexed;
}

function diagnoseMahakImages(MahakClient $client, int $visitorId): array
{
    $response = $client->getAllData([
        'currentVisitorId' => $visitorId,
        'fromProductVersion' => 0,
        'fromProductDetailVersion' => 0,
        'fromPictureVersion' => 0,
        'fromPhotoGalleryVersion' => 0,
        'pageSize' => Config::int('SYNC_PAGE_SIZE', 100),
    ]);
    $data = ciValue($response, 'Data', []);
    $objects = is_array($data) ? ciValue($data, 'Objects', []) : [];
    if (!is_array($objects)) {
        return ['pictures' => [], 'photo_galleries' => []];
    }
    return [
        'pictures' => summarizeMediaRows(ciValue($objects, 'Pictures', [])),
        'photo_galleries' => summarizeMediaRows(ciValue($objects, 'PhotoGalleries', [])),
    ];
}

function summarizeMediaRows(mixed $items): array
{
    if (!is_array($items)) {
        return ['count' => 0, 'rows' => []];
    }
    $rows = [];
    foreach (array_slice($items, 0, 20) as $item) {
        if (!is_array($item)) {
            continue;
        }
        $fields = [];
        foreach ($item as $key => $value) {
            $field = (string) $key;
            if (is_string($value) && strlen($value) > 256) {
                $fields[$field] = [
                    'type' => 'large_string',
                    'length' => strlen($value),
                    'prefix' => substr($value, 0, 24),
                ];
            } elseif (is_scalar($value) || $value === null) {
                $fields[$field] = $value;
            } elseif (is_array($value)) {
                $fields[$field] = ['type' => 'array', 'count' => count($value)];
            } else {
                $fields[$field] = ['type' => get_debug_type($value)];
            }
        }
        $rows[] = $fields;
    }
    return ['count' => count($items), 'rows' => $rows];
}

function diagnosticRows(mixed $items, string $idKey): array
{
    if (!is_array($items)) {
        return [];
    }
    $rows = [];
    foreach (array_slice($items, 0, 5) as $item) {
        if (!is_array($item)) {
            continue;
        }
        $candidates = [];
        foreach ($item as $key => $value) {
            if ((is_int($value) || is_float($value) || is_string($value))
                && preg_match('/price|cost|sale|buy|count|stock|asset|amount|fee/i', (string) $key) === 1) {
                $candidates[(string) $key] = $value;
            }
        }
        $rows[] = [
            'id' => ciValue($item, $idKey),
            'keys' => array_keys($item),
            'candidate_values' => $candidates,
        ];
    }
    return $rows;
}

function ciValue(array $data, string $key, mixed $default = null): mixed
{
    foreach ($data as $candidate => $value) {
        if (strcasecmp((string) $candidate, $key) === 0) {
            return $value;
        }
    }
    return $default;
}

function createMixinTestProduct(MixinClient $client): array
{
    assertMixinTestWritesAllowed();
    $payload = TestProductFactory::make(null, Config::int('MIXIN_TEST_CATEGORY_ID'));
    $response = $client->createProduct($payload);

    return [
        'ok' => true,
        'safety' => ['available' => false, 'stock' => 0],
        'request_identifier' => $payload['product_identifier'],
        'response' => $response,
        'next' => 'Record the returned product id, verify it in Mixin, then delete with mixin:test-product:delete PRODUCT_ID.',
    ];
}

function optionalPositiveInt(string $name): ?int
{
    $value = getenv($name);
    if ($value === false || trim($value) === '') {
        return null;
    }
    $parsed = filter_var($value, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);
    if ($parsed === false) {
        throw new InvalidArgumentException("Environment variable {$name} must be a positive integer");
    }
    return (int) $parsed;
}

function deleteMixinTestProduct(MixinClient $client, ?string $rawId): array
{
    assertMixinTestWritesAllowed();
    $id = filter_var($rawId, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);
    if ($id === false) {
        throw new InvalidArgumentException('A positive PRODUCT_ID is required');
    }

    $response = $client->product((int) $id);
    $product = ciValue($response, 'data', $response);
    if (!is_array($product) || !TestProductFactory::isMarked($product)) {
        throw new RuntimeException('Refusing to delete: product does not contain the Bridge test marker');
    }

    return ['ok' => true, 'product_id' => (int) $id, 'response' => $client->deleteProduct((int) $id)];
}

function assertMixinTestWritesAllowed(): void
{
    if (!Config::bool('MIXIN_ALLOW_TEST_WRITES', false)) {
        throw new RuntimeException('Test writes are disabled. Set MIXIN_ALLOW_TEST_WRITES=true temporarily.');
    }
}

function ensureFallbackCategory(MixinClient $client): array
{
    assertFullCatalogWriteAllowed();
    $name = Config::string('SYNC_FALLBACK_CATEGORY_NAME', 'بدون دسته‌بندی');
    $response = $client->categories(['name' => $name, 'page' => 1, 'page_size' => 100]);
    foreach (nestedRows($response) as $row) {
        if (trim((string) ciValue($row, 'name', '')) === $name) {
            return [
                'ok' => true,
                'action' => 'existing',
                'category_id' => ciValue($row, 'id'),
                'category_name' => $name,
                'next' => 'Set SYNC_FALLBACK_CATEGORY_ID to category_id.',
            ];
        }
    }
    $created = $client->createCategory(['name' => $name]);
    $id = ciValue(is_array(ciValue($created, 'data')) ? ciValue($created, 'data') : $created, 'id');
    if (filter_var($id, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]) === false) {
        throw new RuntimeException('Mixin category response did not contain a valid id');
    }
    return [
        'ok' => true,
        'action' => 'created',
        'category_id' => (int) $id,
        'category_name' => $name,
        'next' => 'Set SYNC_FALLBACK_CATEGORY_ID to category_id.',
    ];
}

/** @return list<array<string,mixed>> */
function nestedRows(array $value): array
{
    $rows = [];
    $walk = static function (array $node) use (&$rows, &$walk): void {
        if (ciValue($node, 'id') !== null && ciValue($node, 'name') !== null) {
            $rows[] = $node;
        }
        foreach ($node as $child) {
            if (is_array($child)) {
                $walk($child);
            }
        }
    };
    $walk($value);
    return $rows;
}

function runFullCatalog(): array
{
    assertFullCatalogWriteAllowed();
    if (Config::bool('SYNC_DRY_RUN', true)) {
        throw new RuntimeException('Full catalogue write requires SYNC_DRY_RUN=false');
    }
    return AppFactory::fullCatalogSync()->run(false);
}

function assertFullCatalogWriteAllowed(): void
{
    if (!Config::bool('SYNC_ALLOW_FULL_CATALOG_WRITE', false)) {
        throw new RuntimeException('Full catalogue writes are disabled. Set SYNC_ALLOW_FULL_CATALOG_WRITE=true temporarily.');
    }
}

function purgeAllMixinProducts(array $argv): array
{
    if (!Config::bool('MIXIN_ALLOW_PRODUCT_PURGE', false)) {
        throw new RuntimeException('Product purge is disabled. Set MIXIN_ALLOW_PRODUCT_PURGE=true temporarily.');
    }
    if (($argv[2] ?? '') !== 'DELETE-ALL-PRODUCTS') {
        throw new InvalidArgumentException('Exact confirmation argument DELETE-ALL-PRODUCTS is required');
    }

    $lockPath = Config::path('SYNC_LOCK_FILE', 'var/product-sync.lock');
    $directory = dirname($lockPath);
    if (!is_dir($directory) && !mkdir($directory, 0770, true) && !is_dir($directory)) {
        throw new RuntimeException("Unable to create sync lock directory: {$directory}");
    }
    $handle = fopen($lockPath, 'c+');
    if ($handle === false || !flock($handle, LOCK_EX | LOCK_NB)) {
        if (is_resource($handle)) {
            fclose($handle);
        }
        throw new RuntimeException('Refusing purge: a product sync is currently running');
    }
    try {
        $client = AppFactory::mixin();
        $productIds = listAllMixinProductIds($client);
        $completedBatches = 0;
        foreach (array_chunk($productIds, 100) as $batch) {
            $client->bulkUpdateProducts([
                'items' => [[
                    'product_ids' => $batch,
                    'action' => 'delete',
                ]],
            ]);
            $completedBatches++;
        }
        AppFactory::state()->resetProductSyncState();
        return [
            'ok' => true,
            'scope' => 'all_mixin_products',
            'products_found' => count($productIds),
            'products_deleted' => count($productIds),
            'batches_completed' => $completedBatches,
            'local_product_state_reset' => true,
            'next' => 'Set MIXIN_ALLOW_PRODUCT_PURGE=false immediately.',
        ];
    } finally {
        flock($handle, LOCK_UN);
        fclose($handle);
    }
}

/** @return list<int> */
function listAllMixinProductIds(MixinClient $client): array
{
    $ids = [];
    for ($page = 1; $page <= 100; $page++) {
        $response = $client->products([
            'page' => $page,
            'page_size' => 1000,
            'fields' => 'id',
        ]);
        $rows = ciValue($response, 'data', []);
        if (!is_array($rows)) {
            throw new RuntimeException('Mixin product list response has no data array');
        }
        foreach ($rows as $row) {
            if (!is_array($row)) {
                continue;
            }
            $id = filter_var(ciValue($row, 'id'), FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]);
            if ($id !== false) {
                $ids[(int) $id] = (int) $id;
            }
        }
        if (count($rows) < 1000) {
            return array_values($ids);
        }
    }
    throw new RuntimeException('Mixin product listing exceeded 100 pages; purge was not started');
}

function syncOneProduct(array $argv, bool $dryRun): array
{
    $sourceId = positiveIdArgument($argv[2] ?? null, 'PRODUCT_DETAIL_ID');
    $categoryId = positiveIdArgument($argv[3] ?? null, 'MIXIN_CATEGORY_ID');
    if (!$dryRun) {
        assertSingleProductWriteAllowed();
    }
    return AppFactory::productSync()->runOne($sourceId, (int) $categoryId, $dryRun);
}

function rollbackOneProduct(array $argv): array
{
    assertSingleProductWriteAllowed();
    return AppFactory::productSync()->rollbackOne(positiveIdArgument($argv[2] ?? null, 'PRODUCT_DETAIL_ID'));
}

function positiveIdArgument(?string $value, string $name): string
{
    if ($value === null || filter_var($value, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]) === false) {
        throw new InvalidArgumentException("A positive {$name} is required");
    }
    return $value;
}

function assertSingleProductWriteAllowed(): void
{
    if (!Config::bool('SYNC_ALLOW_SINGLE_PRODUCT_WRITE', false)) {
        throw new RuntimeException('Single-product writes are disabled. Set SYNC_ALLOW_SINGLE_PRODUCT_WRITE=true temporarily.');
    }
}

function previewOneProductImage(array $argv): array
{
    return AppFactory::productSync()->previewImage(positiveIdArgument($argv[2] ?? null, 'PRODUCT_DETAIL_ID'));
}

function applyOneProductImage(array $argv): array
{
    assertSingleProductWriteAllowed();
    return AppFactory::productSync()->applyImage(positiveIdArgument($argv[2] ?? null, 'PRODUCT_DETAIL_ID'));
}

function rollbackOneProductImage(array $argv): array
{
    assertSingleProductWriteAllowed();
    $sourceId = positiveIdArgument($argv[2] ?? null, 'PRODUCT_DETAIL_ID');
    $imageId = positiveIdArgument($argv[3] ?? null, 'IMAGE_ID');
    return AppFactory::productSync()->rollbackImage($sourceId, (int) $imageId);
}
