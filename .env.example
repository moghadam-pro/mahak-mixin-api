APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
BRIDGE_API_KEY=change-this-long-random-secret

MAHAK_BASE_URL=https://mahakacc.mahaksoft.com/API/v3
MAHAK_LOGIN_PATH=/Sync/Login
MAHAK_GET_ALL_DATA_PATH=/Sync/GetAllData
MAHAK_SAVE_ALL_DATA_PATH=/Sync/SaveAllData
MAHAK_USERNAME=
MAHAK_PASSWORD=
MAHAK_DATABASE_ID=
MAHAK_VISITOR_ID=
MAHAK_PACKAGE_NO=

MIXIN_BASE_URL=https://your-shop-domain.example
MIXIN_API_KEY=

SYNC_DRY_RUN=true
SYNC_PAGE_SIZE=100
SYNC_PRICE_DIVISOR=10
SYNC_TIMEOUT_SECONDS=30
SYNC_VERIFY_TLS=true
STATE_DB=var/bridge.sqlite
