APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
BRIDGE_API_KEY=change-this-long-random-secret
DASHBOARD_USERNAME=customer
DASHBOARD_PASSWORD_HASH=

MAHAK_BASE_URL=https://mahakacc.mahaksoft.com/API/v3
MAHAK_LOGIN_PATH=/Sync/Login
MAHAK_GET_ALL_DATA_PATH=/Sync/GetAllData
MAHAK_SAVE_ALL_DATA_PATH=/Sync/SaveAllData
MAHAK_USERNAME=
MAHAK_PASSWORD=
MAHAK_DATABASE_ID=
MAHAK_VISITOR_ID=
MAHAK_PACKAGE_NO=

MIXIN_BASE_URL=https://your-shop-domain.example
MIXIN_API_KEY=
MIXIN_ALLOW_TEST_WRITES=false
MIXIN_TEST_CATEGORY_ID=

SYNC_DRY_RUN=true
SYNC_ALLOW_SINGLE_PRODUCT_WRITE=false
SYNC_CATEGORY_MAP_JSON={}
SYNC_PRODUCT_CATEGORY_MAP_JSON={"11629315":6,"11629316":21,"11629317":21,"11629318":24}
SYNC_LOCK_FILE=var/product-sync.lock
SYNC_PAGE_SIZE=100
SYNC_PRICE_DIVISOR=10
SYNC_TIMEOUT_SECONDS=30
SYNC_HTTP_MAX_RETRIES=2
SYNC_VERIFY_TLS=true
STATE_DB=var/bridge.sqlite
